#!/usr/bin/env python3
# desc: Linear issues as one line each (id, state, priority, title, project); filter and search.
# usage: linear-find [-q text] [--project X] [--state "In Progress"] [--mine] [--since 7d] [--limit 25]
# effect: read
# replaces: mcp__claude_ai_Linear__list_issues
"""Lean replacement for the Linear connector's list_issues.

The connector returns nested priority, status and label objects for each issue, and up to 250
of them by default. This asks GraphQL for exactly the columns printed.
"""

import datetime as dt
import os
import re
import sys

# Keep __pycache__ out of the shared library checkout.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib"))

import lean  # noqa: E402


FIELDS = [
    "id",
    "state",
    "priority",
    "title",
    "project",
    "assignee",
    "labels",
    "updated",
    "due",
    "url",
]
DEFAULT_FIELDS = ["id", "state", "priority", "title", "project"]

QUERY = """
query($filter: IssueFilter, $first: Int) {
  issues(filter: $filter, first: $first, orderBy: updatedAt) {
    pageInfo { hasNextPage }
    nodes {
      identifier title priorityLabel updatedAt dueDate url
      state { name } project { name } assignee { name } labels { nodes { name } }
    }
  }
}
"""


def main():
    p = lean.parser(__doc__.splitlines()[0], DEFAULT_FIELDS, FIELDS)
    p.add_argument("-q", "--query", help="text in the title or description")
    p.add_argument("--project", help="project name, substring match")
    p.add_argument("--state", help='state name, e.g. "In Progress"; "open" = not done/canceled')
    p.add_argument("--mine", action="store_true", help="assigned to me")
    p.add_argument("--label", help="label name")
    p.add_argument("--since", help="updated within, e.g. 7d or 2026-11-01")
    p.add_argument("--limit", type=int, default=25)
    p.set_defaults(max_chars=120)

    args = p.parse_args()

    data = lean.linear(QUERY, {"filter": _filter(args), "first": args.limit})
    rows = [_row(node) for node in data["issues"]["nodes"]]

    more = "--limit %d" % (args.limit * 2) if data["issues"]["pageInfo"]["hasNextPage"] else None

    lean.emit(rows, args, FIELDS, text_fields=("title",), more=more)


def _filter(args):
    flt = {}

    if args.query:
        flt["or"] = [
            {"title": {"containsIgnoreCase": args.query}},
            {"description": {"containsIgnoreCase": args.query}},
        ]

    if args.project:
        flt["project"] = {"name": {"containsIgnoreCase": args.project}}

    if args.state == "open":
        flt["state"] = {"type": {"nin": ["completed", "canceled"]}}
    elif args.state:
        flt["state"] = {"name": {"eqIgnoreCase": args.state}}

    if args.mine:
        flt["assignee"] = {"isMe": {"eq": True}}

    if args.label:
        flt["labels"] = {"name": {"eqIgnoreCase": args.label}}

    if args.since:
        flt["updatedAt"] = {"gte": _since(args.since)}

    return flt


def _since(text):
    match = re.fullmatch(r"(\d+)d", text)

    if match:
        moment = dt.datetime.now(dt.timezone.utc) - dt.timedelta(days=int(match.group(1)))
        return moment.isoformat()

    return dt.datetime.fromisoformat(text).astimezone(dt.timezone.utc).isoformat()


def _row(node):
    return {
        "id": node["identifier"],
        "state": (node.get("state") or {}).get("name", ""),
        "priority": node.get("priorityLabel", ""),
        "title": node["title"],
        "project": (node.get("project") or {}).get("name", ""),
        "assignee": (node.get("assignee") or {}).get("name", ""),
        "labels": [n["name"] for n in node["labels"]["nodes"]],
        "updated": (node.get("updatedAt") or "")[:10],
        "due": node.get("dueDate") or "",
        "url": node.get("url", ""),
    }


if __name__ == "__main__":
    lean.main(main)
